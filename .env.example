# ─── Admin Analytics Dashboard ─────────────────────────────────────────────
# Copy to .env.local for development; set the same vars in Vercel for prod.
# Every integration degrades gracefully — unset vars show setup hints in the
# dashboard instead of breaking it. See docs/ADMIN_DASHBOARD.md for setup.

# Required: gates /admin and /api/admin/* (middleware + signed cookie)
ADMIN_PASSWORD=
# Optional: separate cookie-signing secret (defaults to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=

# Telemetry events database (Neon Postgres — free tier)
# https://console.neon.tech → create project → copy the pooled connection string
DATABASE_URL=

# Analytics accuracy & privacy toggles (both optional)
# Raw search query text is stored by default (powers "Most searched terms").
# Set to false to strip terms at ingestion — query length + match counts kept.
TRACK_SEARCH_TERMS=
# Visits carrying a valid admin session cookie are excluded from analytics
# by default (your own dashboard checks don't inflate the numbers).
# Set to true to count admin traffic too.
TRACK_ADMIN_TRAFFIC=

# Google Analytics 4 — client-side tag (public)
NEXT_PUBLIC_GA_ID=

# GA4 Data API + Search Console (server-side, service account)
# Google Cloud → IAM → Service Accounts → create key (JSON), then:
#  - email = client_email from the JSON
#  - private key = private_key from the JSON (keep the \n escapes)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GA4 property id (Admin → Property settings → Property ID, numeric)
GA4_PROPERTY_ID=
# Search Console property, e.g. sc-domain:pdfsearch.info or https://www.pdfsearch.info/
GSC_SITE_URL=

# ─── Feedback notifications (Resend) ───────────────────────────────────────
# Without these, feedback is still stored in the database — you just aren't
# emailed about it. https://resend.com → API Keys
RESEND_API_KEY=
# Where feedback notifications are delivered (server-only, never exposed)
FEEDBACK_NOTIFY_EMAIL=
# Verified sender address, e.g. "PDFSearch <feedback@yourdomain.com>"
RESEND_FROM=
# Optional: Resend audience id for the newsletter signup
RESEND_AUDIENCE_ID=

# ─── Additional analytics & verification (all optional) ────────────────────
# Microsoft Clarity project id — heatmaps and session replay
NEXT_PUBLIC_CLARITY_ID=
# Bing Webmaster Tools: the `msvalidate.01` content value
NEXT_PUBLIC_BING_VERIFICATION=

# ─── Support / monetization ───────────────────────────────────────────────
# Patreon page URL. Unset (default) makes /support show an honest
# "being set up" note instead of a dead link.
NEXT_PUBLIC_PATREON_URL=

# Google AdSense. BOTH must be set before a single ad renders — with either
# unset the rail returns null, the ad script never loads, and /ads.txt 404s.
# See docs/ADS_SETUP.md for the full procedure, including the Google-certified
# consent message required for EEA/UK/Swiss traffic.
#   client: AdSense → Account → "ca-pub-…"
#   slot:   AdSense → Ads → create a 160x600 display unit → data-ad-slot value
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_RAIL_SLOT=

# ─── Privacy ──────────────────────────────────────────────────────────────
# HMAC key for hashing visitor IPs. Falls back to ADMIN_SESSION_SECRET, then
# ADMIN_PASSWORD. With no secret at all, IP hashing is disabled entirely and
# NULL is stored — safe, but you lose unique/returning-visitor accuracy.
IP_HASH_SECRET=
